{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel-api.example/schemas/booking.schema.json",
  "title": "Booking",
  "description": "Đơn đặt phòng (GET /bookings/{bookingId}). Top-level resource: có lifecycle riêng và được truy vấn theo guest, hotel, ngày, trạng thái. Ràng buộc checkOut > checkIn và tồn phòng là business rule, kiểm tra ở service layer (JSON Schema không so sánh hai field được).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "hotel", "guest", "checkIn", "checkOut", "nights", "items", "total", "createdAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^bkg_[0-9]{4}_[a-z0-9]{6,12}$", "readOnly": true},
    "confirmationCode": {"type": "string", "pattern": "^[A-Z0-9]{8}$", "readOnly": true},
    "status": {"enum": ["pending", "confirmed", "checked_in", "checked_out", "cancelled", "no_show"]},
    "hotel": {
      "description": "Embed tối thiểu để hiển thị; chi tiết qua GET /hotels/{id}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^hot_[a-z0-9]{6,24}$"},
        "name": {"type": "string"}
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fullName"],
      "properties": {
        "id": {"type": "string", "pattern": "^gst_[a-z0-9]{6,24}$"},
        "fullName": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "checkIn": {"type": "string", "format": "date"},
    "checkOut": {"type": "string", "format": "date"},
    "nights": {"type": "integer", "minimum": 1, "maximum": 30, "readOnly": true},
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adults"],
      "properties": {
        "adults": {"type": "integer", "minimum": 1, "maximum": 40},
        "children": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "items": {
      "description": "Composition Booking → BookingItem (junction Booking ↔ RoomType có metadata: quantity, nightlyRate snapshot).",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/bookingItem"}
    },
    "specialRequests": {"type": "string", "maxLength": 1000},
    "total": {"$ref": "#/$defs/money", "readOnly": true},
    "paymentStatus": {"enum": ["unpaid", "partially_paid", "paid", "refunded"], "readOnly": true},
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "readOnly": true,
      "required": ["cancelledAt", "refund"],
      "properties": {
        "cancelledAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "maxLength": 500},
        "refund": {"$ref": "#/$defs/money"}
      }
    },
    "createdAt": {"type": "string", "format": "date-time", "readOnly": true},
    "updatedAt": {"type": "string", "format": "date-time", "readOnly": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]},
      "then": {"required": ["cancellation"]},
      "else": {"not": {"required": ["cancellation"]}}
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "integer", "minimum": 0},
        "currency": {"enum": ["VND", "USD"]}
      }
    },
    "bookingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomType", "quantity", "nightlyRate", "subtotal"],
      "properties": {
        "roomType": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": {"type": "string", "pattern": "^rmt_[a-z0-9]{6,24}$"},
            "name": {"type": "string"}
          }
        },
        "quantity": {"type": "integer", "minimum": 1, "maximum": 10},
        "nightlyRate": {"$ref": "#/$defs/money", "description": "Snapshot giá lúc đặt — không đổi khi baseRate của room type thay đổi."},
        "subtotal": {"$ref": "#/$defs/money"},
        "assignedRooms": {
          "description": "Số phòng vật lý, chỉ có sau khi check-in.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9A-Z-]{1,10}$"}
        }
      }
    }
  }
}
